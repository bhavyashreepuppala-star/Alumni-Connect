# ===================================================
# ALUMNI CONNECT - Root Environment Template
# Copy this to .env in development (or configure server/.env and client/.env)
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MySQL 8 via Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/alumni_connect?schema=public"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars-long"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="cookie-session-signing-secret-change-in-production"

# LinkedIn OAuth 2.0 / OpenID Connect (Phase 1 Stubbed Architecture)
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_REDIRECT_URI="http://localhost:5000/api/auth/linkedin/callback"

# Email Service (Nodemailer Architecture)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_mailtrap_user"
SMTP_PASS="your_mailtrap_password"
EMAIL_FROM="no-reply@alumniconnect.edu"

# Cloud Storage (Cloudinary Architecture)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Client Vite Environment
VITE_API_URL="http://localhost:5000/api"
VITE_APP_NAME="Alumni Connect"
