PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL 8 Connection String
# Adjust user and password to match your local MySQL configuration
DATABASE_URL="mysql://root:root@localhost:3306/alumni_connect?schema=public"

# JWT Authentication
JWT_SECRET="dev-insecure-secret-key-change-this-for-production-use"
JWT_EXPIRES_IN="7d"

# LinkedIn OAuth 2.0 / OpenID Connect credentials
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:5000/api/auth/linkedin/callback"

# Optional Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional SMTP Configuration
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@alumniconnect.edu"
